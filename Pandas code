import pandas as pd

data = {
    "Name": ["Omar", "Lina", "Ali", "Sara"],
    "Age": [27, 30, 25, None],
    "Salary": [35000, None, 45000, 50000]
}

df = pd.DataFrame(data)

# 1. Count missing values in each column
print(df.isnull().sum())

# 2. Replace missing salary with 40000
df["Salary"] = df["Salary"].fillna(40000)

#3. replace missing age with 45 
df['Age']=df["Age"].fillna(45)

# 3. Display the updated table
print(df)



import pandas as pd

data = {
    "Name": ["Omar", "Lina", "Ali", "Sara"],
    "Age": [27, 30, 25, None],
    "Salary": [35000, None, 45000, 50000],
    "Department": ["Sales", "IT", "Sales", "IT"]
}

df = pd.DataFrame(data)


# 1. Filter rows where Department is IT
print(df[df["Department"] == "IT"])

# 2. Calculate the average salary before filling missing values
print(df["Salary"].mean())

# 3. Fill the missing salary and save the change
df["Salary"] = df["Salary"].fillna(40000)

# 4. Count missing values in each column
print(df.isnull().sum())
